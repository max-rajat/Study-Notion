# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Server port (defaults to 4000)
PORT=4000

# --- Required: the server refuses to start without these ---
MONGODB_URL=
JWT_SECRET=

# Public URL of the frontend. Used for CORS *and* for the links in
# password-reset emails, so it must be set in production or reset links will
# point at localhost.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email. Pick ONE of the two blocks below.
# ---------------------------------------------------------------------------

# Option A — Resend HTTP API (port 443). Required on hosts that block outbound
# SMTP, which includes Render, Fly and Heroku free tiers. Takes precedence over
# the SMTP settings whenever RESEND_API_KEY is present.
RESEND_API_KEY=
# From-address. Must be on a domain verified in Resend. Before you verify one,
# onboarding@resend.dev works but delivers ONLY to the address that owns the
# Resend account.
MAIL_FROM=StudyNotion <onboarding@resend.dev>

# Option B — SMTP (used only when RESEND_API_KEY is empty). Fine for local
# development. For Gmail, MAIL_PASS must be a 16-character App Password, not
# the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# How long to wait for the mail provider before giving up (ms, default 10000).
MAIL_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Cloudinary (image and video uploads)
# ---------------------------------------------------------------------------
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=

# ---------------------------------------------------------------------------
# Razorpay. RAZORPAY_KEY is the public key id; the frontend needs the same
# value as REACT_APP_RAZORPAY_KEY. RAZORPAY_SECRET must never be exposed.
# ---------------------------------------------------------------------------
RAZORPAY_KEY=
RAZORPAY_SECRET=
