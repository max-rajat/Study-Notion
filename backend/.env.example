# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in.
# .env is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# Server port (defaults to 4000)
PORT=4000

# --- Required: the server refuses to start without these ---
MONGODB_URL=
JWT_SECRET=

# Public URL of the frontend. Used for CORS *and* for the links in
# password-reset emails, so it must be set in production or reset links will
# point at localhost.
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email. Pick ONE of the two blocks below.
# ---------------------------------------------------------------------------

# Option A — Brevo HTTP API (port 443). Required on hosts that block outbound
# SMTP, which includes Render, Fly and Heroku free tiers. Takes precedence over
# the SMTP settings whenever BREVO_API_KEY is present.
#
# Unlike most transactional-email free tiers, Brevo delivers to ANY recipient
# once a single sender address is verified (Settings -> Senders, Domains &
# IPs -> Add a Sender -> click the confirmation email) — no domain required.
BREVO_API_KEY=
# Must be the address you verified as a sender in Brevo.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=StudyNotion

# Option B — SMTP (used only when BREVO_API_KEY is empty). Fine for local
# development. For Gmail, MAIL_PASS must be a 16-character App Password, not
# the account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# How long to wait for the mail provider before giving up (ms, default 16000).
MAIL_TIMEOUT_MS=16000

# Demo-only: when no mail provider is reachable, this returns the
# password-reset link directly in the API response instead of emailing it, so
# reset stays usable. It removes the proof of mailbox ownership —
# never enable it on a deployment with real users. Leave unset otherwise.
# DEMO_MODE=true

# ---------------------------------------------------------------------------
# Cloudinary (image and video uploads)
# ---------------------------------------------------------------------------
CLOUD_NAME=
API_KEY=
API_SECRET=
FOLDER_NAME=

# ---------------------------------------------------------------------------
# Razorpay. RAZORPAY_KEY is the public key id; the frontend needs the same
# value as REACT_APP_RAZORPAY_KEY. RAZORPAY_SECRET must never be exposed.
# ---------------------------------------------------------------------------
RAZORPAY_KEY=
RAZORPAY_SECRET=
